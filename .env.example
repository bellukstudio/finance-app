# Set di Vercel > Project > Settings > Environment Variables (Production & Preview)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server-only, JANGAN pakai prefix NEXT_PUBLIC_
CRON_SECRET=                      # string acak panjang; Vercel Cron memakainya otomatis
APP_URL=https://finance.example.com   # fallback saja; origin diambil dari request
